
<html><head>
<title>מערכת ניהול - IMKNASIM</title>
<meta charset="UTF-8">
<link rel="stylesheet" type="text/css" href="admin.css">
</head>
<body>
<div style="float:right;width:100%">
<div style="margin:0px auto;width:440px;height:200px;box-sizing:border-box;padding:20px;background-color:#FAFAFA;text-align:right">
<form method=post action="checkUSer.asp">
<div style="float:right;width:100%;font-size:24px;margin-bottom:10px">
    <div style="float:right;width:40%">
        שם משתמש
    </div>
    <div style="float:right;width:50%">
       <input style="width:100%;height:30px;border:0px;background-color:#EAEAEA;border-radius:8px;box-sizing:border-box;padding-right:10px;font-size:18px" type=text name=username ID="Text1">
    </div>
</div>
<div style="float:right;width:100%;font-size:24px">
    <div style="float:right;width:40%">
        סיסמא
    </div>
    <div style="float:right;width:50%">
        <input style="width:100%;height:30px;border:0px;background-color:#EAEAEA;border-radius:8px;box-sizing:border-box;padding-right:10px;font-size:18px" type=password name=password ID="Text2">
    </div>
</div>
<div style="float:right;width:100%;font-size:24px">
    <input style="width:200px;height:40px;background-color:#EAEAEA;box-sizing:border-box;border-radius:8px;border:0px;margin-top:20px;font-size:24px" type=submit name=submitbutton value=כניסה ID="Password1">
</div>
</form>
</div>
</div>
</body>
</html>